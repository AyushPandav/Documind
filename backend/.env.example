# DocuMind Gateway Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# PRIMARY LLM: Mistral Large API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# FALLBACK LLM: Groq API (Ultra-fast cloud inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NeonDB Cloud Serverless PostgreSQL with pgvector (Optional Cloud Sync)
NEON_DATABASE_URL=
ENABLE_CLOUD_SYNC=False

# Fully Homomorphic Encryption (FHE)
FHE_POLY_MODULUS_DEGREE=8192
FHE_GLOBAL_SCALE_EXPONENT=40
